<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive databases -->
        <exclude domain="database" path="electrofix_database"/>
        <exclude domain="database" path="electrofix_database-shm"/>
        <exclude domain="database" path="electrofix_database-wal"/>
        <exclude domain="database" path="app_database.db"/>
        <exclude domain="database" path="app_database.db-shm"/>
        <exclude domain="database" path="app_database.db-wal"/>

        <!-- Exclude admin settings -->
        <exclude domain="sharedpref" path="admin_prefs_encrypted.xml"/>
        <exclude domain="sharedpref" path="admin_settings_prefs.xml"/>

        <!-- Exclude credentials/keys -->
        <exclude domain="file" path="credentials/"/>
        <exclude domain="file" path="keys/"/>

        <!-- Allow other app data to sync -->
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </cloud-backup>

    <device-transfer>
        <!-- Device-to-device transfer restrictions -->
        <exclude domain="database" path="electrofix_database"/>
        <exclude domain="database" path="electrofix_database-shm"/>
        <exclude domain="database" path="electrofix_database-wal"/>
        <exclude domain="database" path="app_database.db"/>
        <exclude domain="database" path="app_database.db-shm"/>
        <exclude domain="database" path="app_database.db-wal"/>
        <exclude domain="sharedpref" path="admin_prefs_encrypted.xml"/>
        <exclude domain="sharedpref" path="admin_settings_prefs.xml"/>
        <exclude domain="file" path="credentials/"/>

        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
